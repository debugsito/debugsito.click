---

<svg class="mesh" viewBox="0 0 1200 800" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="mesh-stroke" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="currentColor" stop-opacity="0.34"></stop>
      <stop offset="55%" stop-color="currentColor" stop-opacity="0.14"></stop>
      <stop offset="100%" stop-color="currentColor" stop-opacity="0.04"></stop>
    </linearGradient>
  </defs>
  <g fill="none" stroke="url(#mesh-stroke)" stroke-width="1.15">
    {
      edges.map(([a, b], i) => (
        <line
          data-edge={i}
          data-a={a}
          data-b={b}
          x1={nodes[a][0]}
          y1={nodes[a][1]}
          x2={nodes[b][0]}
          y2={nodes[b][1]}
        />
      ))
    }
  </g>
  <g fill="currentColor">
    {
      nodes.map(([x, y], i) => (
        <circle data-node={i} cx={x} cy={y} r={i % 4 === 0 ? 3.6 : 2.6} opacity={0.42} />
      ))
    }
  </g>
</svg>
