---
const links = [
  { href: '/#produccion', label: 'Rack' },
  { href: '/#opensource', label: 'OSS' },
  { href: '/#bitacora', label: 'Bitácora', optional: true },
  { href: '/#contacto', label: 'Contacto', optional: true },
  { href: '/now', label: 'Ahora', optional: true },
  { href: '/changelog', label: 'Log', optional: true },
];
---

<header class="site-header" transition:name="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" transition:name="brand-link">debugsito</a>
    <nav class="nav" aria-label="Principal">
      <div class="nav__links">
        {
          links.map((l) => (
            <a class={l.optional ? 'nav__desk-optional' : undefined} href={l.href}>
              {l.label}
            </a>
          ))
        }
      </div>
      <div class="nav__tools">
        <button type="button" class="icon-btn" data-theme-toggle aria-pressed="false">
          tema
        </button>
        <button type="button" class="icon-btn" data-arcade-open>
          arcade
        </button>
        <button type="button" class="icon-btn" data-term-open aria-controls="term-dock" aria-expanded="false">
          shell
        </button>
      </div>
    </nav>
  </div>
</header>
