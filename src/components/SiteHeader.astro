---
const links = [
  { href: '/#produccion', label: 'Producción', desk: true },
  { href: '/#evolucion', label: 'Evolución', desk: true },
  { href: '/#contacto', label: 'Contacto' },
  { href: '/now', label: 'Ahora' },
  { href: '/changelog', label: 'Changelog', desk: true },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">debugsito</a>
    <nav class="nav" aria-label="Principal">
      {
        links.map((l) => (
          <a class={l.desk ? 'nav__desk' : undefined} href={l.href}>
            {l.label}
          </a>
        ))
      }
      <button type="button" class="icon-btn" data-theme-toggle aria-pressed="false">
        tema · auto
      </button>
      <button type="button" class="icon-btn" data-term-open aria-controls="term" aria-expanded="false">
        terminal
      </button>
    </nav>
  </div>
</header>
