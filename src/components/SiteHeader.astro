---
const links = [
  { href: '/#produccion', label: 'Producción', extra: true },
  { href: '/#evolucion', label: 'Evolución', extra: true },
  { href: '/#repos', label: 'Repos', extra: true },
  { href: '/now', label: 'Ahora' },
  { href: '/changelog', label: 'Changelog' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">debugsito</a>
    <nav class="nav" aria-label="Principal">
      {
        links.map((l) => (
          <a class={l.extra ? 'nav__extra' : undefined} href={l.href}>
            {l.label}
          </a>
        ))
      }
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Cambiar tema">
        tema
      </button>
    </nav>
  </div>
</header>
