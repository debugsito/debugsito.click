---
import { profile } from '../lib/data';

const checks = profile.live_checks ?? [];
---

<div class="status-strip" data-status-strip aria-label="Estado de subdominios">
  {
    checks.map((c) => (
      <a class="status-item" href={c.url} data-check-url={c.url} rel="noopener noreferrer">
        <span class="led led--unknown" data-led aria-hidden="true" />
        <span>{c.label}.debugsito.click</span>
        <span data-status-label>sin comprobar</span>
      </a>
    ))
  }
</div>

<script>
  const items = document.querySelectorAll('[data-check-url]');

  async function probe(el: Element) {
    const url = el.getAttribute('data-check-url');
    const led = el.querySelector('[data-led]');
    const label = el.querySelector('[data-status-label]');
    if (!url || !led || !label) return;

    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 3500);

    try {
      await fetch(url, {
        method: 'GET',
        mode: 'no-cors',
        cache: 'no-store',
        signal: ctrl.signal,
      });
      led.classList.remove('led--unknown', 'led--down');
      led.classList.add('led--live');
      label.textContent = 'en línea';
    } catch {
      led.classList.remove('led--unknown', 'led--live');
      led.classList.add('led--down');
      label.textContent = 'sin respuesta';
    } finally {
      clearTimeout(timer);
    }
  }

  items.forEach((el) => probe(el));
</script>
