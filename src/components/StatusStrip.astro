---
import { status } from '../lib/data';

const checks = status.checks ?? [];
const fetched = status.fetched_at
  ? new Date(status.fetched_at).toLocaleString('es-PE', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'America/Lima',
    })
  : null;
---

<div class="status-strip" aria-label="Estado de subdominios públicos">
  <div class="status-strip__rows">
    {
      checks.map((c) => (
        <a
          class="status-item"
          href={c.url}
          rel="noopener noreferrer"
          data-status={c.ok ? 'up' : 'down'}
        >
          <span
            class:list={['led', c.ok ? 'led--live led--build' : 'led--down']}
            aria-hidden="true"
          />
          <span>{c.label}.debugsito.click</span>
          <span>{c.ok ? 'up · build' : 'down · build'}</span>
        </a>
      ))
    }
  </div>
  {
    fetched ? (
      <p class="status-strip__note">
        Comprobado en el build · {fetched} (hora Lima). No es un ping en vivo del navegador.
      </p>
    ) : (
      <p class="status-strip__note">Estado pendiente del próximo build.</p>
    )
  }
</div>
