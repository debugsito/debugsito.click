---
---

<aside
  class="term-dock"
  id="term-dock"
  data-term-dock
  data-expanded="false"
  aria-label="Shell debugsito"
  transition:persist="term-dock"
>
  <div class="term-dock__panel" id="term" hidden>
    <div class="term-dock__bar">
      <span>guest@debugsito.click</span>
      <div class="term-dock__actions">
        <button type="button" class="icon-btn term-dock__btn" data-term-collapse>
          minimizar
        </button>
      </div>
    </div>
    <pre class="term-dock__out" id="term-out" aria-live="polite"></pre>
  </div>

  <form class="term-dock__form" id="term-form" autocomplete="off">
    <button
      type="button"
      class="term-dock__grip"
      data-term-toggle
      aria-controls="term"
      aria-expanded="false"
      title="Expandir o minimizar historial"
    >
      <span class="term-dock__prompt" aria-hidden="true">$</span>
    </button>
    <span class="term-dock__cwd" data-term-cwd title="directorio actual">~</span>
    <label class="term-dock__field">
      <span class="visually-hidden">Comando</span>
      <input
        id="term-input"
        name="cmd"
        spellcheck="false"
        aria-label="Comando de la shell"
        placeholder="ls"
      />
    </label>
  </form>
</aside>

<script>
  import { bootTerminal } from '../scripts/terminal';
  bootTerminal();
  document.addEventListener('astro:page-load', () => bootTerminal());
</script>
