---
---

<div
  class="term"
  id="term"
  role="dialog"
  aria-modal="true"
  aria-label="Terminal"
  aria-hidden="true"
  data-open="false"
>
  <div class="term__bar">
    <span>debugsito://shell</span>
    <button type="button" class="icon-btn term__close" data-term-close style="background:#1a1f27;color:#d7dbdf;border-color:#2c333d">
      esc
    </button>
  </div>
  <pre class="term__out" id="term-out"></pre>
  <form class="term__form" id="term-form" autocomplete="off">
    <span aria-hidden="true">$</span>
    <input id="term-input" name="cmd" spellcheck="false" aria-label="Comando" />
  </form>
</div>

<script>
  import { bootTerminal } from '../scripts/terminal';
  bootTerminal();
  document.addEventListener('astro:page-load', () => bootTerminal());
</script>
